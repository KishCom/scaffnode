{
    "name": "scaffnode-frontend",
    "version": "0.106.0",
    "description": "The Svelte.js based frontend for scaffnode",
    "type": "module",
    "author": "Your Name <you.name@example.org>",
    "contributors": [
        {
            "name": "Foo Bar",
            "email": "foo.bar@example.com"
        }
    ],
    "scripts": {
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "build": "NODE_ENV=dev npx webpack --config webpack.config.js",
        "build.live": "NODE_ENV=live npx webpack --config webpack.config.js",
        "watch": "NODE_ENV=dev npx webpack --watch --config webpack.config.js"
    },
    "devDependencies": {
        "lodash": "^4.18.1",
        "sass": "^1.108.2",
        "tar": "^7.5.23",
        "@fortawesome/fontawesome-free": "6.x.x",
        "@swc/cli": "^0.8.x",
        "@swc/core": "^1.16.22",
        "autoprefixer": "^10.6.2",
        "bootstrap": "^5.x.x",
        "clean-webpack-plugin": "4.x.x",
        "css-loader": "^7.1.5",
        "eslint": "10.x.x",
        "eslint-plugin-svelte": "^3.24.1",
        "file-loader": "^6.2.0",
        "git-revision-webpack-plugin": "^5.0.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "mini-css-extract-plugin": "^2.10.2",
        "sass-loader": "^17.x.x",
        "style-loader": "^4.0.0",
        "svelte": "^5.x.x",
        "svelte-check-plugin": "^1.0.4",
        "svelte-loader": "^3.2.4",
        "svelte-preprocess": "^6.x.x",
        "swc-loader": "^0.2.7",
        "webpack": "^5.x.x",
        "webpack-cli": "^7.x.x"
    },
    "overrides": {
        "tar": "^7.5.23"
    },
    "private": true,
    "allowScripts": {
        "nice-napi@1.0.2": true,
        "@swc/core@1.16.22": true
    },
    "jest": {
        "testEnvironment": "jsdom",
        "extensionsToTreatAsEsm": [".svelte"],
        "moduleFileExtensions": ["js", "mjs", "svelte"],
        "transform": {
            "^.+\\.svelte$": "<rootDir>/tests/svelteJestTransformer.mjs"
        },
        "moduleNameMapper": {
            "\\.(css|scss|sass)$": "<rootDir>/tests/styleMock.js"
        }
    }
}
